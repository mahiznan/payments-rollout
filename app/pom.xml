<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>payment-api</artifactId>
    <version>1.0.0</version>
    <name>payment-api</name>
    <description>Payment authorization API used to demo zero-downtime rollouts on OpenShift</description>

    <properties>
        <java.version>25</java.version>
    </properties>

    <dependencies>
        <!-- REST endpoints (Spring MVC + embedded Tomcat) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Health endpoints, including the liveness and readiness probe groups -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>

    <build>
        <!-- Fixed jar name so the Dockerfile does not depend on the version -->
        <finalName>payment-api</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- The plugin's auto-detection only finds a public main(), and
                         PaymentApplication uses the Java 25 package-private form -->
                    <mainClass>com.example.payments.PaymentApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
